package com.autoservice;

import com.autoservice.domain.Customer;
import com.autoservice.employee.*;
import com.autoservice.repository.InMemoryOrderRepository;
import com.autoservice.service.*;

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/**
 * Application context – single source of truth for all services and employee registry.
 * Acts as a simple DI container (no framework needed for this demo).
 */
public class AppContext {

    private static AppContext instance;

    private final InMemoryOrderRepository orderRepository;
    private final NotificationManager notificationManager;
    private final ScheduleManager scheduleManager;
    private final Inventory inventory;
    private final OrderService orderService;
    private final VehicleManager vehicleManager;
    private final ProfileManager profileManager;

    private final Map<String, Employee> employees = new LinkedHashMap<>();
    private final Map<String, Customer> loggedInCustomers = new LinkedHashMap<>();

    private final List<String> pendingStorekeeperNotifs = new ArrayList<>();

    private AppContext() {
        orderRepository    = new InMemoryOrderRepository();
        notificationManager = new NotificationManager();
        scheduleManager    = new ScheduleManager();
        inventory          = new Inventory();
        orderService       = new OrderService(orderRepository, notificationManager, scheduleManager, inventory);
        vehicleManager     = new VehicleManager();
        profileManager     = new ProfileManager();

        seedDemoData();
    }

    public static AppContext getInstance() {
        if (instance == null) instance = new AppContext();
        return instance;
    }

    public void addStorekeeperNotif(String msg) {
        pendingStorekeeperNotifs.add(msg);
    }

    public List<String> getAndClearStorekeeperNotifs() {
        List<String> copy = new ArrayList<>(pendingStorekeeperNotifs);
        pendingStorekeeperNotifs.clear();
        return copy;
    }

    // ---- seed ------------------------------------------------------------
    private void seedDemoData() {
        // employees
        ReceptionTechnician rt = new ReceptionTechnician(1, "Jana", "Nováková", "jana@servis.sk");
        Dispatcher dp          = new Dispatcher(2, "Peter", "Kováč", "peter@servis.sk");
        Mechanic m1            = new Mechanic(3, "Milan", "Sloboda", "milan@servis.sk", "Motor");
        Mechanic m2            = new Mechanic(4, "Tomáš", "Horváth", "tomas@servis.sk", "Elektrika");
        Storekeeper sk         = new Storekeeper(5, "Eva", "Baranová", "eva@servis.sk");

        employees.put(rt.getEmail(), rt);
        employees.put(dp.getEmail(), dp);
        employees.put(m1.getEmail(), m1);
        employees.put(m2.getEmail(), m2);
        employees.put(sk.getEmail(), sk);

        // customers
        Customer marek = Customer.register("Marek", "Novák", "marek@mail.com", "0910123456", "heslo");
        Customer jan   = Customer.register("Ján", "Horák", "jan@gmail.com", "0900111222", "heslo123");
        Customer maria = Customer.register("Mária", "Kováčová", "maria@gmail.com", "0900333444", "heslo123");
        Customer peter = Customer.register("Peter", "Sloboda", "peter@gmail.com", "0911222333", "heslo123");
        Customer lucia = Customer.register("Lucia", "Benková", "lucia@gmail.com", "0912345678", "heslo123");

        profileManager.saveProfile(marek);
        profileManager.saveProfile(jan);
        profileManager.saveProfile(maria);
        profileManager.saveProfile(peter);
        profileManager.saveProfile(lucia);

        // Marek – Opel Astra Turbo 1.4
        var vMarek = vehicleManager.createVehicleCard("Opel", "Astra",
 "W0L0AHL4811234567", "2014", "Turbo 1.4", "KS619GD");
        vehicleManager.createAndRegisterCard(marek, vMarek);

        // Ján – Škoda Octavia
        var vJan = vehicleManager.createVehicleCard("Škoda", "Octavia",
 "TMBJJ7NE0J0123456", "2018", "2.0 TDI", "BA123AB");
        vehicleManager.createAndRegisterCard(jan, vJan);

        // Mária – VW Golf
        var vMaria = vehicleManager.createVehicleCard("Volkswagen", "Golf",
 "WVWZZZ1KZBW123456", "2020", "1.6 TDI", "BA456CD");
        vehicleManager.createAndRegisterCard(maria, vMaria);

        // Peter – Toyota Corolla
        var vPeter = vehicleManager.createVehicleCard("Toyota", "Corolla",
 "JTDBU4EE20J123456", "2021", "1.8 Hybrid", "NR789EF");
        vehicleManager.createAndRegisterCard(peter, vPeter);

        // Lucia – BMW 320d
        var vLucia = vehicleManager.createVehicleCard("BMW", "320d",
 "WBA3B31090F123456", "2019", "2.0 Diesel", "SC321GH");
        vehicleManager.createAndRegisterCard(lucia, vLucia);

        // spare parts in inventory
        com.autoservice.domain.SparePart sp1 = new com.autoservice.domain.SparePart("SP001", "Olejový filter", 12.50, "5");
        com.autoservice.domain.SparePart sp2 = new com.autoservice.domain.SparePart("SP002", "Vzduchový filter", 18.00, "3");
        com.autoservice.domain.SparePart sp3 = new com.autoservice.domain.SparePart("SP003", "Brzdové doštičky", 45.00, "2");
        inventory.addPart(sp1, 10);
        inventory.addPart(sp2, 6);
        inventory.addPart(sp3, 4);
    }

    // ---- accessors -------------------------------------------------------
    public InMemoryOrderRepository getOrderRepository()      { return orderRepository; }
    public NotificationManager     getNotificationManager() { return notificationManager; }
    public ScheduleManager         getScheduleManager()     { return scheduleManager; }
    public Inventory               getInventory()           { return inventory; }
    public OrderService            getOrderService()        { return orderService; }
    public VehicleManager          getVehicleManager()      { return vehicleManager; }
    public ProfileManager          getProfileManager()      { return profileManager; }
    public Map<String, Employee>   getEmployees()           { return employees; }

    public Employee findEmployee(String email) { return employees.get(email); }

    public Employee findEmployeeByRole(String role) {
        return switch (role.toLowerCase()) {
            case "technik"  -> employees.values().stream()
                    .filter(e -> e instanceof ReceptionTechnician).findFirst().orElse(null);
            case "dispecer" -> employees.values().stream()
                    .filter(e -> e instanceof Dispatcher).findFirst().orElse(null);
            case "mechanik" -> employees.values().stream()
                    .filter(e -> e instanceof Mechanic).findFirst().orElse(null);
            case "skladnik" -> employees.values().stream()
                    .filter(e -> e instanceof Storekeeper).findFirst().orElse(null);
            default -> null;
        };
    }
}